{
  "entities": {
    "ClassroomSession": {
      "title": "ClassroomSession",
      "description": "A session representing a live classroom instance.",
      "type": "object",
      "properties": {
        "teacher_user_id": { "type": "string" },
        "session_code": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "level": { "type": "string" },
        "lesson_goal": { "type": "string" },
        "active_phase": { "type": "string", "enum": ["START", "INSTRUCTIE", "CHECK", "VERWERKEN", "AFSLUITING"] },
        "status": { "type": "string", "enum": ["PLANNED", "ACTIVE", "PAUSED", "ENDED"] },
        "board_message": { "type": "string" },
        "active_prompt_id": { "type": "string" },
        "timer_started_at": { "type": "string" },
        "timer_duration_seconds": { "type": "number" },
        "is_locked": { "type": "boolean" },
        "shared_signal_id": { "type": "string" },
        "widgets_json": { "type": "string" },
        "prep_json": { "type": "string" },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["teacher_user_id", "session_code", "subject", "active_phase", "status"]
    },
    "ClassroomParticipant": {
      "title": "ClassroomParticipant",
      "description": "A student or participant in the classroom session.",
      "type": "object",
      "properties": {
        "classroom_session_id": { "type": "string" },
        "student_user_id": { "type": "string" },
        "display_name": { "type": "string" },
        "participant_key": { "type": "string" },
        "join_status": { "type": "string", "enum": ["JOINED", "ACTIVE", "IDLE", "LEFT"] },
        "device_type": { "type": "string" },
        "timeout_until": { "type": "string" },
        "can_draw": { "type": "boolean" },
        "team_name": { "type": "string" },
        "joined_at": { "type": "string" },
        "last_seen_at": { "type": "string" }
      },
      "required": ["classroom_session_id", "display_name", "join_status", "joined_at"]
    },
    "ClassroomSignal": {
      "title": "ClassroomSignal",
      "description": "A signal generated by a participant or the system.",
      "type": "object",
      "properties": {
        "classroom_session_id": { "type": "string" },
        "participant_id": { "type": "string" },
        "prompt_id": { "type": "string" },
        "phase": { "type": "string" },
        "signal_type": { "type": "string", "enum": ["HELP", "WORD", "CHECK", "EXIT", "RESPONSE", "DRAWING"] },
        "subtype": { "type": "string" },
        "urgency": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "status": { "type": "string", "enum": ["NEW", "ACKNOWLEDGED", "RESOLVED"] },
        "text_value": { "type": "string" },
        "short_code_value": { "type": "string" },
        "numeric_value": { "type": "number" },
        "choice_value": { "type": "string" },
        "payload_json": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["classroom_session_id", "participant_id", "phase", "signal_type", "status", "created_at"]
    },
    "ClassroomPrompt": {
      "title": "ClassroomPrompt",
      "description": "A prompt sent to the class or a specific participant.",
      "type": "object",
      "properties": {
        "classroom_session_id": { "type": "string" },
        "phase": { "type": "string" },
        "prompt_type": { "type": "string" },
        "title": { "type": "string" },
        "prompt_text": { "type": "string" },
        "response_mode": { "type": "string" },
        "target_participant_id": { "type": "string" },
        "status": { "type": "string" },
        "opened_at": { "type": "string" },
        "closed_at": { "type": "string" }
      },
      "required": ["classroom_session_id", "phase", "prompt_type", "prompt_text", "status", "opened_at"]
    },
    "ClassroomSummary": {
      "title": "ClassroomSummary",
      "description": "A summary generated for a session.",
      "type": "object",
      "properties": {
        "classroom_session_id": { "type": "string" },
        "phase": { "type": "string" },
        "summary_type": { "type": "string" },
        "headline": { "type": "string" },
        "body": { "type": "string" },
        "evidence_count": { "type": "number" },
        "confidence_label": { "type": "string" },
        "summary_json": { "type": "string" },
        "generator_type": { "type": "string" },
        "is_active": { "type": "boolean" },
        "generated_at": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["classroom_session_id", "phase", "summary_type", "headline", "generator_type", "generated_at", "created_at"]
    },
    "LessonTemplate": {
      "title": "LessonTemplate",
      "description": "A reusable lesson preparation template.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "grade_level": { "type": "string" },
        "prep_json": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string" },
        "downloads_count": { "type": "number" }
      },
      "required": ["title", "subject", "prep_json", "created_by", "created_at"]
    }
  },
  "firestore": {
    "lesson_templates/{templateId}": {
      "schema": { "$ref": "#/entities/LessonTemplate" },
      "description": "Global library of reusable lesson plans."
    },
    "classroom_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ClassroomSession" },
      "description": "Stores live sessions."
    },
    "classroom_sessions/{sessionId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/ClassroomParticipant" },
      "description": "Stores participants of a specific session."
    },
    "classroom_sessions/{sessionId}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/ClassroomSignal" },
      "description": "Stores signals sent during a specific session."
    },
    "classroom_sessions/{sessionId}/prompts/{promptId}": {
      "schema": { "$ref": "#/entities/ClassroomPrompt" },
      "description": "Stores prompts triggered during a session."
    },
    "classroom_sessions/{sessionId}/summaries/{summaryId}": {
      "schema": { "$ref": "#/entities/ClassroomSummary" },
      "description": "Stores AI summaries for a session."
    }
  }
}
